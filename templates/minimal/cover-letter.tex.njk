%-------------------------
% Cover letter (resumely minimal): moderncv "banking" style, see LICENSE
%-------------------------

((* include "preamble.tex.njk" *))
((* include "header.tex.njk" *))

\AtBeginDocument{\hypersetup{pdfauthor={(((about.name)))}, pdftitle={(((about.name))) — Cover Letter}, pdfsubject={(((job.role))) at (((job.company)))}}}

((* if about.links.length *))
% The banking letter head lists no socials; show the same links one per line after the contact details
\extrainfo{\collectionloop{socials}{\ifnum\value{collection@iterator}>0 \makenewline\fi\csname\collectionloopkey socialsymbol\endcsname\collectionloopitem}}
((* endif *))
\recipient{Hiring Team}{(((job.company)))}
\date{(((date)))}
\opening{(((letter.greeting)))}
\closing{(((letter.closing)))}

\begin{document}

\makelettertitle

\textbf{Re: (((job.role)))}
((* for p in letter.paragraphs *))

(((p.text)))
((* endfor *))

\makeletterclosing

\par\message{RESUMELY-FILL \the\pagetotal\space\the\textheight}
\end{document}
